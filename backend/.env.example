#-----BASE DE DATOS-----
# Para correr proyecto con localhost (docker-compose / MySQL local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=cine
DB_PASSWORD=cine_password
DB_NAME=cine_paradiso
DB_SSL=false

# Para correr proyecto con TiDB Cloud (se reemplaza el bloque de arriba por este)
# DB_HOST=host_tidb_cloud
# DB_PORT=4000
# DB_USER=<prefijo>.root
# DB_PASSWORD=password_tidb_cloud
# DB_NAME=cine_paradiso
# DB_SSL=true


#-----SEGURIDAD-----
JWT_SECRET_KEY=clave_secreta_para_jwt


#-----URL DEL FRONTEND-----
# Para correr con localhost
FRONTEND_URL=http://127.0.0.1:5000
# Para correr con Render (se reemplaza el bloque de arriba por este)
# FRONTEND_URL=link_frontend_render


#-----SERVICIOS EXTERNOS-----
OMDB_API_KEY=clave_de_api_omdb

# Mails por SMTP (solo localhost)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=correo@gmail.com
SMTP_USER=correo@gmail.com
SMTP_PASSWORD=password_de_aplicacion


#-----APP-----
TOLERANCIA_INGRESO_MIN=15